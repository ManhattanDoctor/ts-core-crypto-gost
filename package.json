{
    "name": "@ts-core/crypto-gost",
    "version": "3.0.9",
    "description": "TypeScript library for Russian GOST cryptographic standards (GOST R 34.10, GOST R 34.11) - key generation, signing, verification, encryption and decryption",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/common": "~3.0.57",
        "@vostokplatform/crypto-gost-js": "^2.0.1",
        "source-map": "^0.7.4"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-crypto-gost.git"
    },
    "keywords": [
        "typescript",
        "gost",
        "cryptography",
        "gost-r-34.10",
        "gost-r-34.11",
        "digital-signature",
        "encryption",
        "russian-crypto",
        "ts-core"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/ts-core-crypto-gost/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/ts-core-crypto-gost#readme"
}
